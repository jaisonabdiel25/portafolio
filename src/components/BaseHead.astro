---
// Metadatos globales y carga de fuentes. Incluido en el <head> a través del layout.
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../types/portfolio';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Ruta absoluta de la imagen para Open Graph (en /public). */
  image?: string;
}

const { title, description, lang, image = '/images/og.jpg' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Alternativas de idioma para SEO (hreflang).
const esURL = new URL(localizePath(Astro.url.pathname, 'es'), Astro.site);
const enURL = new URL(localizePath(Astro.url.pathname, 'en'), Astro.site);
---

<!-- Metadatos globales -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0a0a0f" />
<meta name="color-scheme" content="dark" />

<!-- Fuentes (Space Grotesk, Inter, JetBrains Mono) vía la API de Astro -->
<Font cssVariable="--ff-display" preload />
<Font cssVariable="--ff-sans" preload />
<Font cssVariable="--ff-mono" />

<!-- Canónica + alternativas de idioma -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="es" href={esURL} />
<link rel="alternate" hreflang="en" href={enURL} />
<link rel="alternate" hreflang="x-default" href={esURL} />

<!-- Meta principales -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

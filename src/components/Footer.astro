---
import Icon from './Icon.astro';
import { portfolio } from '../data/portfolio';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../types/portfolio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { name, socials } = portfolio.profile;
const year = new Date().getFullYear();
---

<footer class="section-shell !py-10">
  <div
    class="glass flex flex-col items-center justify-between gap-4 rounded-2xl px-6 py-6 text-center sm:flex-row sm:text-left"
  >
    <div>
      <p class="font-display text-sm font-semibold text-fg">{name}</p>
      <p class="mt-1 text-xs text-muted">
        © {year} {name}. {t('footer.rights')}
      </p>
    </div>

    <div class="flex items-center gap-2">
      {
        socials.map((social) => (
          <a
            href={social.url}
            target={social.platform === 'email' ? undefined : '_blank'}
            rel="noopener noreferrer"
            aria-label={social.label ?? social.platform}
            class="grid size-10 place-items-center rounded-full border border-edge text-muted transition-colors hover:bg-surface-strong hover:text-fg"
          >
            <Icon name={social.platform} size={18} />
          </a>
        ))
      }
    </div>
  </div>
  <p class="mt-4 text-center font-mono text-xs text-muted">{t('footer.builtWith')}</p>
</footer>

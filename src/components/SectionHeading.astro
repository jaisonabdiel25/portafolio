---
// Encabezado de sección consistente: número + título + subtítulo opcional.
interface Props {
  index: string;
  title: string;
  subtitle?: string;
}
const { index, title, subtitle } = Astro.props;
---

<div class="reveal mb-10 flex flex-col gap-3">
  <span class="font-mono text-sm font-medium text-accent-text">{index}</span>
  <h2 class="font-display text-3xl font-bold tracking-tight text-fg sm:text-4xl">{title}</h2>
  {subtitle && <p class="max-w-2xl text-muted">{subtitle}</p>}
  <span class="h-px w-16 bg-accent"></span>
</div>

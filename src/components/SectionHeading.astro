---
// Encabezado de sección.
//
// Sin numeración: los eyebrows (`01`, `02`…) son un dispositivo ORDINAL y
// estas secciones no lo son — "Sobre mí" no va antes de "Proyectos" por
// ninguna razón. Cuando todo está numerado, nada tiene jerarquía.
//
// `size` diferencia las cabeceras entre sí para que la página no sea una
// lista de listas etiquetadas idénticas.
interface Props {
  title: string;
  subtitle?: string;
  /** `lg` para la sección eje de la página (Proyectos); `md` por defecto. */
  size?: 'md' | 'lg';
  /** Regla de acento bajo el título. Desactívala para variar el ritmo. */
  rule?: boolean;
  class?: string;
}
const { title, subtitle, size = 'md', rule = true, class: className = '' } = Astro.props;

const titleClass =
  size === 'lg'
    ? 'font-display text-4xl font-bold tracking-tight text-fg sm:text-6xl'
    : 'font-display text-3xl font-bold tracking-tight text-fg sm:text-4xl';
---

<div class:list={['flex flex-col gap-3', size === 'lg' ? 'mb-12' : 'mb-10', className]}>
  <h2 class={titleClass}>{title}</h2>
  {subtitle && <p class="max-w-2xl text-muted">{subtitle}</p>}
  {rule && <span class="h-px w-16 bg-accent"></span>}
</div>

---
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import { portfolio } from '../../data/portfolio';
import { techIcons } from '../../data/tech-icons';
import { loc, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../types/portfolio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Categorías completas para la vista de lista (incluye las habilidades
// conceptuales sin logo, p. ej. REST APIs o Clean Architecture).
const categories = portfolio.skills;

// Color de acento al hover: si el color de marca es muy oscuro (Next.js, GitHub,
// Express…), usa el acento para que siga siendo visible en modo oscuro.
function hoverColor(hex: string): string {
  const r = parseInt(hex.slice(0, 2), 16);
  const g = parseInt(hex.slice(2, 4), 16);
  const b = parseInt(hex.slice(4, 6), 16);
  const lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
  return lum < 0.38 ? 'var(--c-accent)' : `#${hex}`;
}

// Solo las tecnologías con logo real (las que tienen `slug` en techIcons)
// entran en la nube; las conceptuales del JSON (REST APIs, Clean Architecture…)
// no tienen slug y se omiten a propósito.
const all = portfolio.skills
  .flatMap((c) => c.items)
  .filter((s) => s.slug && techIcons[s.slug])
  .map((s) => {
    const icon = techIcons[s.slug!];
    return { name: s.name, level: s.level ?? 70, slug: s.slug as string, icon, brand: hoverColor(icon.hex) };
  });
type Tech = (typeof all)[number];

const sizes = { principal: 'size-12 sm:size-16', other: 'size-8 sm:size-10' };

// Tecnologías principales (más grandes). El resto, ordenado por nivel.
const PRINCIPAL = ['nextdotjs', 'dotnet', 'nodedotjs', 'typescript'];
const bySlug = new Map(all.map((t) => [t.slug, t] as const));
const principal = PRINCIPAL.map((sl) => bySlug.get(sl)).filter((t): t is Tech => Boolean(t));
const others = all.filter((t) => !PRINCIPAL.includes(t.slug)).sort((a, b) => b.level - a.level);

// Fila fluida (flex-wrap): se intercalan las principales entre las demás para
// que los iconos grandes queden esparcidos horizontalmente, no agrupados.
const queueOthers = [...others];
const queuePrincipal = [...principal];
const cloud: (Tech & { size: string })[] = [];
let count = 0;
while (queueOthers.length || queuePrincipal.length) {
  if (queuePrincipal.length && (count % 4 === 3 || queueOthers.length === 0)) {
    cloud.push({ ...queuePrincipal.shift()!, size: sizes.principal });
  } else {
    cloud.push({ ...queueOthers.shift()!, size: sizes.other });
  }
  count++;
}
---

<section id="skills" class="section-shell" style="--pad-block: 3.5rem 5rem;">
  <SectionHeading title={t('section.skills')} subtitle={t('skills.subtitle')} />

  <!-- Pestañas: nube de iconos vs. lista detallada. Centradas para alinear
       con la nube de iconos, que también lo está. -->
  <div class="mb-10 flex justify-center">
    <div
      role="tablist"
      aria-label={t('section.skills')}
      class="inline-flex gap-1 rounded-full border border-edge bg-panel p-1"
    >
      <button
        type="button"
        role="tab"
        id="skills-tab-icons"
        data-tab="icons"
        aria-selected="true"
        aria-controls="skills-panel-icons"
        tabindex="0"
        class="skills-tab inline-flex cursor-pointer items-center gap-2 whitespace-nowrap rounded-full px-4 py-2 text-sm font-medium text-muted transition-colors hover:text-fg aria-selected:bg-accent aria-selected:text-accent-fg"
      >
        <Icon name="grid" size={16} />
        {t('skills.tab.icons')}
      </button>
      <button
        type="button"
        role="tab"
        id="skills-tab-list"
        data-tab="list"
        aria-selected="false"
        aria-controls="skills-panel-list"
        tabindex="-1"
        class="skills-tab inline-flex cursor-pointer items-center gap-2 whitespace-nowrap rounded-full px-4 py-2 text-sm font-medium text-muted transition-colors hover:text-fg aria-selected:bg-accent aria-selected:text-accent-fg"
      >
        <Icon name="list" size={16} />
        {t('skills.tab.list')}
      </button>
    </div>
  </div>

  <!-- Panel: nube de iconos. El nombre va SIEMPRE visible: era la
       información, no un extra que se revelaba al pasar el ratón (y que en
       móvil y con teclado no aparecía nunca). -->
  <div id="skills-panel-icons" role="tabpanel" aria-labelledby="skills-tab-icons" tabindex="0">
    <ul class="flex flex-wrap items-end justify-center gap-x-8 gap-y-8 py-4 sm:gap-x-12">
      {
        cloud.map((tech) => (
          <li class="group flex w-16 flex-col items-center gap-2 sm:w-20" style={`--brand: ${tech.brand};`}>
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class={`${tech.size} text-muted transition-[color,transform] duration-200 group-hover:-translate-y-1 group-hover:text-(--brand)`}
            >
              <path d={tech.icon.path} />
            </svg>
            <span class="text-center text-xs font-medium text-muted">{tech.name}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Panel: lista detallada por categoría, con el nivel de dominio (el dato
       `level` existía en los datos y no se mostraba en ninguna vista). -->
  <div id="skills-panel-list" role="tabpanel" aria-labelledby="skills-tab-list" tabindex="0" hidden>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        categories.map((cat) => (
          <div class="panel p-6">
            <h3 class="mb-5 flex items-center gap-2 font-display text-lg font-semibold text-fg">
              <Icon name={cat.icon ?? 'sparkles'} size={20} class="text-accent-text" />
              {loc(cat.category, lang)}
            </h3>
            <ul class="flex flex-col gap-3">
              {cat.items.map((item) => {
                const icon = item.slug ? techIcons[item.slug] : undefined;
                return (
                  <li class="flex items-center gap-3">
                    {icon ? (
                      <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                        class="size-4 shrink-0 text-muted"
                      >
                        <path d={icon.path} />
                      </svg>
                    ) : (
                      <span class="size-4 shrink-0" aria-hidden="true" />
                    )}
                    <span class="min-w-0 flex-1 truncate text-sm font-medium text-fg">
                      {item.name}
                    </span>
                    {typeof item.level === 'number' && (
                      <span
                        role="meter"
                        aria-valuenow={item.level}
                        aria-valuemin={0}
                        aria-valuemax={100}
                        aria-label={`${t('skills.level')}: ${item.name}`}
                        class="h-1 w-16 shrink-0 overflow-hidden rounded-full bg-edge sm:w-20"
                      >
                        <span
                          class="block h-full rounded-full bg-accent"
                          style={`width: ${item.level}%;`}
                        />
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Patrón WAI-ARIA de pestañas COMPLETO: si el marcado promete role="tab",
  // debe entregar flechas ←/→, Home/End y tabindex móvil (solo la pestaña
  // activa es tabulable). Media implementación de ARIA es peor que ninguna.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.skills-tab'));
  const panels: Record<string, HTMLElement | null> = {
    icons: document.getElementById('skills-panel-icons'),
    list: document.getElementById('skills-panel-list'),
  };

  function selectTab(key: string, moveFocus = false) {
    tabs.forEach((tab) => {
      const on = tab.dataset.tab === key;
      tab.setAttribute('aria-selected', String(on));
      tab.tabIndex = on ? 0 : -1;
      if (on && moveFocus) tab.focus({ preventScroll: true });
    });
    Object.entries(panels).forEach(([k, panel]) => panel && (panel.hidden = k !== key));
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => selectTab(tab.dataset.tab ?? 'icons'));

    tab.addEventListener('keydown', (event) => {
      const offsets: Record<string, number> = {
        ArrowRight: i + 1,
        ArrowLeft: i - 1,
        Home: 0,
        End: tabs.length - 1,
      };
      const target = offsets[event.key];
      if (target === undefined) return;
      event.preventDefault();
      const next = tabs[(target + tabs.length) % tabs.length];
      selectTab(next.dataset.tab ?? 'icons', true);
    });
  });
</script>

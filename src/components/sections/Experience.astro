---
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import { portfolio } from '../../data/portfolio';
import { loc, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../types/portfolio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const items = portfolio.experience;

function formatEnd(end: string): string {
  const lower = end.toLowerCase();
  if (lower === 'actual' || lower === 'present' || lower === 'now') return t('experience.now');
  return end;
}
---

<section id="experience" class="section-shell" style="--pad-block: 4rem 5.5rem;">
  <SectionHeading title={t('section.experience')} />

  <!-- Sin tarjetas ni línea de tiempo con puntos: las fechas cuelgan en el
       margen izquierdo y los filos de un píxel llevan el ritmo. Rompe la
       simetría de la página sin añadir una sexta caja de cristal. -->
  <ol class="border-t border-edge">
    {
      items.map((item) => (
        <li class="grid gap-3 border-b border-edge py-6 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-8 sm:py-8">
          <div class="flex items-center gap-2 text-muted sm:flex-col sm:items-start sm:gap-2">
            <Icon
              name={item.type === 'education' ? 'graduation-cap' : 'briefcase'}
              size={18}
              class="text-accent-text"
            />
            <span class="nums font-mono text-xs uppercase tracking-widest">
              {item.start && item.start !== item.end
                ? `${item.start} — ${formatEnd(item.end)}`
                : formatEnd(item.end)}
            </span>
          </div>

          <div>
            <h3 class="font-display text-lg font-semibold text-fg sm:text-xl">
              {loc(item.role, lang)}
            </h3>
            <p class="mt-1 text-sm font-medium text-accent-text">{item.company}</p>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
              {loc(item.description, lang)}
            </p>

            {item.tags && item.tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <li class="rounded-full border border-edge px-2.5 py-1 font-mono text-xs text-muted">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

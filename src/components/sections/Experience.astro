---
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import { portfolio } from '../../data/portfolio';
import { loc, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../types/portfolio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const items = portfolio.experience;

function formatEnd(end: string): string {
  const lower = end.toLowerCase();
  if (lower === 'actual' || lower === 'present' || lower === 'now') return t('experience.now');
  return end;
}
---

<section id="experience" class="section-shell">
  <SectionHeading index="03" title={t('section.experience')} />

  <ol class="relative ml-3 border-l border-edge pl-8 sm:ml-4">
    {
      items.map((item, i) => (
        <li
          class="reveal relative mb-8 last:mb-0"
          style={`--reveal-delay: ${i * 90}ms;`}
        >
          {/* Punto de la línea de tiempo */}
          <span
            class="absolute -left-[2.65rem] grid size-9 place-items-center rounded-full border border-edge bg-surface-strong text-accent-text sm:-left-[2.9rem]"
          >
            <Icon name={item.type === 'education' ? 'graduation-cap' : 'briefcase'} size={16} />
          </span>

          <div class="glass rounded-2xl p-5 transition-colors hover:bg-surface-strong">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="font-display text-lg font-semibold text-fg">{loc(item.role, lang)}</h3>
              <span class="rounded-full border border-edge px-3 py-1 font-mono text-xs text-muted">
                {item.start && item.start !== item.end
                  ? `${item.start} — ${formatEnd(item.end)}`
                  : formatEnd(item.end)}
              </span>
            </div>

            <p class="mt-1 text-sm font-medium text-accent-text">{item.company}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{loc(item.description, lang)}</p>

            {item.tags && item.tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <li class="rounded-full bg-surface-strong px-2.5 py-1 font-mono text-xs text-muted">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

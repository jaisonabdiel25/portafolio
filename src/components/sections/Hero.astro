---
import Icon from '../Icon.astro';
import LampHero from '../react/LampHero.tsx';
import { portfolio } from '../../data/portfolio';
import { loc, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../types/portfolio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { name, role } = portfolio.profile;
---

<section id="home" class="relative">
  <LampHero client:load name={name} role={loc(role, lang)} />

  <!-- Difuminado de empalme: continúa el color del Hero y se desvanece sobre
       el inicio de la siguiente sección para suavizar el corte. -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-40 h-32 translate-y-full bg-[linear-gradient(to_bottom,var(--c-bg-to),transparent)]"
    aria-hidden="true"
  >
  </div>

  <!-- Indicador de scroll -->
  <a
    href="#about"
    class="absolute inset-x-0 bottom-6 z-50 mx-auto flex w-fit flex-col items-center gap-1 text-muted transition-colors hover:text-fg"
    aria-label={t('hero.scroll')}
  >
    <span class="font-mono text-[0.65rem] uppercase tracking-widest">{t('hero.scroll')}</span>
    <Icon name="chevron-down" size={18} class="animate-bounce" />
  </a>
</section>

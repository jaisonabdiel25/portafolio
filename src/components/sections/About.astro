---
import SectionHeading from '../SectionHeading.astro';
import { portfolio } from '../../data/portfolio';
import { loc, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../types/portfolio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { paragraphs, highlights } = portfolio.about;
---

<!-- Sección comprimida a propósito: es la introducción, no el plato fuerte.
     El padding superior (9rem) deja pasar el telón del hero, que mide 8rem. -->
<section id="about" class="section-shell" style="--pad-block: 9rem 3.5rem;">
  <SectionHeading title={t('section.about')} />

  <div class="grid gap-10 md:grid-cols-[1.6fr_1fr] md:gap-14">
    <!-- Texto -->
    <div class="space-y-4 text-base leading-relaxed text-muted sm:text-lg">
      {paragraphs.map((p) => <p>{loc(p, lang)}</p>)}
    </div>

    <!-- Cifras destacadas. Sin tarjeta: una lista con filo superior pesa
         menos y lee mejor que cuatro rectángulos de cristal. -->
    <dl class="grid grid-cols-2 gap-x-6 md:grid-cols-1 md:gap-x-0">
      {
        highlights.map((h) => (
          <div class="border-t border-edge py-4">
            <dt class="text-sm text-muted">{loc(h.label, lang)}</dt>
            <dd class="nums mt-1 font-display text-3xl font-bold text-fg sm:text-4xl">{h.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

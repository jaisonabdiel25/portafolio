---
// Fondo decorativo: blobs de luz ambiental con desenfoque.
// Fijo, detrás de todo el contenido, y no captura eventos del puntero.
---

<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <div
    class="blob left-[-10%] top-[-10%] size-[45vw] min-h-72 min-w-72"
    style="background: var(--c-blob-1); animation-delay: 0s;"
  >
  </div>
  <div
    class="blob right-[-15%] top-[20%] size-[40vw] min-h-72 min-w-72"
    style="background: var(--c-blob-2); animation-delay: -6s;"
  >
  </div>
  <div
    class="blob bottom-[-15%] left-[20%] size-[42vw] min-h-72 min-w-72"
    style="background: var(--c-blob-3); animation-delay: -12s;"
  >
  </div>
  <!-- Velo sutil para mejorar el contraste del texto sobre los blobs -->
  <div
    class="absolute inset-0"
    style="background-color: color-mix(in srgb, var(--c-bg-to) 35%, transparent);"
  >
  </div>
</div>
